# No external API needed — this app uses sqlocal (SQLite in the browser via IndexedDB)
# through src/db/client.ts, so it runs fully on Vercel with no backend.
#
# Local development:  npm run dev
# Deploy:             vercel deploy --prod (or connect the GitHub repo to Vercel)
#
# TablePlus note: sqlocal stores data in browser IndexedDB, not a .sqlite file on disk,
# so TablePlus cannot open it directly. The database lives per-browser.
