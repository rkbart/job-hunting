# Local development: run the Express API server (server.mjs) on port 4000
VITE_API_BASE=http://localhost:4000

# Production on Vercel: set this to your hosted API URL (e.g. Railway/Render/Fly)
# Vercel serverless cannot host a writable SQLite file, so the API + SQLite DB
# should live on a platform with a persistent disk. Then set VITE_API_BASE here
# in the Vercel project settings to point at that API.
